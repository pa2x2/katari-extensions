{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "site_browser": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--executable-path",
          "/usr/bin/brave",
          "--sandbox",
          "--timeout-navigation",
          "90000",
          "--caps",
          "devtools"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  }
}
